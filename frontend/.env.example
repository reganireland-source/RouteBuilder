# RouteBuilder frontend environment variables
# Copy this file to .env.local and fill in values for local development

# Backend API URL (required)
VITE_API_URL=http://localhost:8000

# App password for viewer access (required in the default admin_key auth mode)
VITE_APP_PASSWORD=

# ── Auth mode ─────────────────────────────────────────────────────────────
# "admin_key" (default, unset = same thing) keeps the app exactly as above:
# VITE_APP_PASSWORD gates viewing, admin key gates writes. "okta" or "entra"
# replaces BOTH with a real SSO sign-in that gates the whole app — see
# docs/okta-setup.md / docs/entra-setup.md before switching this, and set it
# to the SAME value as the backend's AUTH_MODE (a mismatch means the
# frontend sends a bearer token the backend isn't expecting, or vice versa).
VITE_AUTH_MODE=admin_key

# ── Okta SSO (only used when VITE_AUTH_MODE=okta) ───────────────────────────
# None of these are secrets — a public OIDC client (single-page app + PKCE)
# never holds a client_secret. Same values as the backend's OKTA_ISSUER /
# OKTA_CLIENT_ID / OKTA_ADMIN_GROUP; see docs/okta-setup.md.
VITE_OKTA_ISSUER=
VITE_OKTA_CLIENT_ID=
VITE_OKTA_ADMIN_GROUP=

# ── Entra ID SSO (only used when VITE_AUTH_MODE=entra) ──────────────────────
# None of these are secrets — same reasoning as the Okta variables above.
# Same values as the backend's ENTRA_TENANT_ID / ENTRA_CLIENT_ID /
# ENTRA_ADMIN_ROLE; see docs/entra-setup.md.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_ADMIN_ROLE=

# Optional: only set this if you named the scope you exposed in "Expose an
# API" something other than "access_as_user". Defaults to
# "api://<VITE_ENTRA_CLIENT_ID>/access_as_user" when unset.
VITE_ENTRA_SCOPE=

# Enable NLP natural-language routing (optional, default: false)
VITE_ENABLE_NLP=false

# ── Deploy-time feature removal ─────────────────────────────────────────────
# These four all default to enabled (today's behaviour) — set to exactly
# "false" to hide the corresponding UI entry point. Match each one to the
# backend's identically-named flag (backend/.env.example) so a disabled
# feature's UI never calls an endpoint the backend has un-mounted.
#
# AI Outage Parser button in Reference Data → Outages (an LLM vision call).
VITE_ENABLE_OUTAGE_PARSER=true

# Cable Import's "✨ Research" button (Wikipedia + an LLM extraction call).
# The rest of Cable Import (manual entry) is unaffected.
VITE_ENABLE_CABLE_IMPORT_RESEARCH=true

# submarinecablemap.com integration: KML Chop Import's "Sync from Submarine
# Cable Map" source mode + Cable Import's optional cable-link field. Not an
# AI feature — a plain third-party fetch, proxied through the backend.
VITE_ENABLE_SCM=true

# Network Hazards overlay's Controls-menu toggle (bushfire.io + USGS feeds,
# proxied through the backend). The toggle itself defaults OFF per-session
# regardless of this flag — this only controls whether it exists at all.
VITE_ENABLE_HAZARDS=true

# Map tile provider: 'osm' uses CARTO tiles (default), 'google' uses Google Maps
# Google Maps requires a valid API key with Maps JavaScript API enabled
VITE_MAPS_PROVIDER=osm

# Google Maps API key — only required when VITE_MAPS_PROVIDER=google
# Create a key at https://console.cloud.google.com/  → APIs & Services → Credentials
# Enable: Maps JavaScript API
VITE_GMAPS_API_KEY=
