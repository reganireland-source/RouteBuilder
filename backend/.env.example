# ──────────────────────────────────────────────────────────────────────────────
# RouteBuilder Backend — Environment Variables
# Copy this file to .env and fill in values before starting the server.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. If not set, app falls back to local JSON files
# (single-user dev mode only — not suitable for production).
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/routebuilder

# ── Access Control ────────────────────────────────────────────────────────────
# AUTH_MODE picks the whole auth model: "admin_key" (default, below), "okta"
# or "entra". Leave unset/blank to keep today's behaviour exactly as-is. See
# docs/okta-setup.md / docs/entra-setup.md for the full IT setup checklist
# before switching this to "okta"/"entra" — the frontend's VITE_AUTH_MODE
# must be set to the SAME value. Only one SSO provider is ever active at a
# time; the unused provider's variables below are simply ignored.
AUTH_MODE=admin_key

# Admin passphrase for write operations (create/update/delete data).
# Users without this key can view all data but cannot make changes.
# If not set, the app runs in open mode (everyone can edit — dev/internal only).
# Replace this with a strong random secret in production.
# Generate one with: openssl rand -base64 32
# Only used when AUTH_MODE=admin_key.
ADMIN_KEY=change-me-before-production

# ── Okta SSO (only used when AUTH_MODE=okta — see docs/okta-setup.md) ────────
# Every request needs a valid Okta session (not just writes); write access
# additionally requires membership in OKTA_ADMIN_GROUP. None of these four
# are secrets — a public OIDC client (single-page app + PKCE) holds no
# client_secret at all, which is what makes this "paste in a few values and
# go" rather than a credential-management exercise for your IT team.

# Your Okta Authorization Server's issuer URI, e.g.
# https://your-org.okta.com/oauth2/default — found on the Authorization
# Server's Settings tab in the Okta admin console.
OKTA_ISSUER=

# The OIDC application's Client ID — found on the app's General tab after
# creating it as a Single-Page Application in the Okta admin console.
OKTA_CLIENT_ID=

# Optional: only set this if your Authorization Server issues access tokens
# with an audience different from OKTA_CLIENT_ID (e.g. a custom API
# identifier like "api://default"). Defaults to OKTA_CLIENT_ID when unset,
# which is correct for the common case.
OKTA_AUDIENCE=

# The exact name of the Okta group whose members get write access. Left
# blank, NOBODY gets admin access (fails closed, not open) — see
# docs/okta-setup.md's "Claims and group mapping" step, which this depends
# on being configured in the Okta admin console first.
OKTA_ADMIN_GROUP=

# ── Entra ID SSO (only used when AUTH_MODE=entra — see docs/entra-setup.md) ──
# Every request needs a valid Entra ID session (not just writes); write
# access additionally requires the ENTRA_ADMIN_ROLE App Role. None of these
# are secrets — a public OIDC client (single-page app + PKCE) holds no
# client_secret at all, same as the Okta variables above.

# Your Entra tenant's Directory (tenant) ID — a GUID, found on the app
# registration's Overview page in the Microsoft Entra admin center.
ENTRA_TENANT_ID=

# The app registration's Application (client) ID — same Overview page.
ENTRA_CLIENT_ID=

# Optional: only set this if you exposed the API under an Application ID URI
# other than the default "api://<ENTRA_CLIENT_ID>" in "Expose an API".
# Defaults to ENTRA_CLIENT_ID when unset, which is correct for the common
# case.
ENTRA_AUDIENCE=

# The exact "Value" (not display name) of the App Role whose holders get
# write access. Left blank, NOBODY gets admin access (fails closed, not
# open) — see docs/entra-setup.md's "Add the App Role and assign it" step,
# which this depends on being configured in the Entra admin center first.
ENTRA_ADMIN_ROLE=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Set to your frontend domain(s) in production. Default ("*") is insecure.
# Example: ALLOWED_ORIGINS=https://routebuilder.yourcompany.com
ALLOWED_ORIGINS=*

# ── NLP / TSABuddy ────────────────────────────────────────────────────────────
# Set to "true" to enable natural language route search.
NLP_ENABLED=false

# Provide exactly ONE of the following API keys to enable NLP.
# Claude (Anthropic) — recommended
ANTHROPIC_API_KEY=

# Azure OpenAI — enterprise option
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# OpenAI direct
OPENAI_API_KEY=

# ── Network Hazards overlay ───────────────────────────────────────────────────
# An optional, OFF-BY-DEFAULT map layer showing live disasters near the network,
# merged from two feeds by the backend so no API key ever reaches the browser.
# See backend/app/hazards/ for the whole pipeline.
#
# bushfire.io — a developer-scoped bearer JWT. Leave BLANK to run with USGS
# alone: the layer still works, the status panel reports the source as
# unconfigured, and nothing else is affected.
#
# COVERAGE IS NOT WORLDWIDE, and this is measured, not assumed: bushfire.io
# serves only Australia (au), North America (na) and Europe (eu). Its Asian
# region returns an empty result and Africa, South America and Antarctica return
# HTTP 500. USGS is global but earthquakes only. The UI states this so an empty
# map is never read as an all-clear.
BUSHFIRE_API_KEY=
BUSHFIRE_API_URL=https://api.bushfire.io

# USGS earthquakes — free, keyless, worldwide. Any GeoJSON summary feed works;
# see https://earthquake.usgs.gov/earthquakes/feed/v1.0/geojson.php
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_week.geojson

# How long an assembled feed is cached before it is rebuilt (seconds). One
# upstream fetch per window serves every open tab.
HAZARDS_TTL_SECONDS=600

# Lowest severity to keep: advisory | watch | warning | emergency.
# Neither upstream can filter by severity, so everything is fetched and the
# floor is applied here.
HAZARDS_MIN_SEVERITY=watch

# Build the hazard cache at startup, in a background thread, so the first request
# after a deploy is a cache hit instead of the ~20s cold build. Set to "false" to
# skip it and build lazily on first request instead.
HAZARDS_WARM_ON_BOOT=true

# How close a hazard must be to an asset before it is flagged, in km. Wet
# segments get a much wider radius because the things that cut subsea cable —
# quakes, submarine landslides — disturb a broad corridor of seabed.
HAZARDS_NODE_RADIUS_KM=25
HAZARDS_TERRESTRIAL_RADIUS_KM=25
HAZARDS_WET_RADIUS_KM=100
