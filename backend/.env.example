# ──────────────────────────────────────────────────────────────────────────────
# RouteBuilder Backend — Environment Variables
# Copy this file to .env and fill in values before starting the server.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. If not set, app falls back to local JSON files
# (single-user dev mode only — not suitable for production).
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/routebuilder

# ── Access Control ────────────────────────────────────────────────────────────
# Admin passphrase for write operations (create/update/delete data).
# Users without this key can view all data but cannot make changes.
# If not set, the app runs in open mode (everyone can edit — dev/internal only).
# Replace this with a strong random secret in production.
# Generate one with: openssl rand -base64 32
ADMIN_KEY=change-me-before-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Set to your frontend domain(s) in production. Default ("*") is insecure.
# Example: ALLOWED_ORIGINS=https://routebuilder.yourcompany.com
ALLOWED_ORIGINS=*

# ── NLP / TSABuddy ────────────────────────────────────────────────────────────
# Set to "true" to enable natural language route search.
NLP_ENABLED=false

# Provide exactly ONE of the following API keys to enable NLP.
# Claude (Anthropic) — recommended
ANTHROPIC_API_KEY=

# Azure OpenAI — enterprise option
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# OpenAI direct
OPENAI_API_KEY=

# ── Network Hazards overlay ───────────────────────────────────────────────────
# An optional, OFF-BY-DEFAULT map layer showing live disasters near the network,
# merged from two feeds by the backend so no API key ever reaches the browser.
# See backend/app/hazards/ for the whole pipeline.
#
# bushfire.io — a developer-scoped bearer JWT. Leave BLANK to run with USGS
# alone: the layer still works, the status panel reports the source as
# unconfigured, and nothing else is affected.
#
# COVERAGE IS NOT WORLDWIDE, and this is measured, not assumed: bushfire.io
# serves only Australia (au), North America (na) and Europe (eu). Its Asian
# region returns an empty result and Africa, South America and Antarctica return
# HTTP 500. USGS is global but earthquakes only. The UI states this so an empty
# map is never read as an all-clear.
BUSHFIRE_API_KEY=
BUSHFIRE_API_URL=https://api.bushfire.io

# USGS earthquakes — free, keyless, worldwide. Any GeoJSON summary feed works;
# see https://earthquake.usgs.gov/earthquakes/feed/v1.0/geojson.php
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_week.geojson

# How long an assembled feed is cached before it is rebuilt (seconds). One
# upstream fetch per window serves every open tab.
HAZARDS_TTL_SECONDS=600

# Lowest severity to keep: advisory | watch | warning | emergency.
# Neither upstream can filter by severity, so everything is fetched and the
# floor is applied here.
HAZARDS_MIN_SEVERITY=watch

# How close a hazard must be to an asset before it is flagged, in km. Wet
# segments get a much wider radius because the things that cut subsea cable —
# quakes, submarine landslides — disturb a broad corridor of seabed.
HAZARDS_NODE_RADIUS_KM=25
HAZARDS_TERRESTRIAL_RADIUS_KM=25
HAZARDS_WET_RADIUS_KM=100
